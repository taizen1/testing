# n8n Docker Stack - Environment Variables
# Copy this to .env and fill in your values: cp .env.example .env

# Domain where n8n is hosted (used by Caddy for HTTPS and n8n for webhook URLs)
N8N_HOST=n8n.yourdomain.com

# PostgreSQL password (generate a strong random password)
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# n8n encryption key for credentials at rest (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
