# Google Maps Platform key with Geocoding API + Distance Matrix API enabled
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# SerpApi key (used to query Google Flights results — there is no official
# public Google Flights API). Free trial credits available.
# https://serpapi.com/
SERPAPI_KEY=

PORT=4000

# Origin(s) allowed to call this API, comma-separated. Used for CORS.
CLIENT_ORIGIN=http://localhost:5173
